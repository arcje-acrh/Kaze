# Kaze as a pacman package, built from this checkout (not a download):
#   cd Kaze/pkg && makepkg -si               -> /usr/bin/kaze, /usr/share/applications/kaze.desktop, /usr/lib/kaze/kaze-share
#   sudo pacman -R kaze               -> removes it again
pkgname=kaze
pkgver=0.1
pkgrel=5
pkgdesc="Kaze, the Udiksa file manager (Qt 6 / QML)"
arch=(x86_64 aarch64)
license=(MIT)
depends=(qt6-base qt6-declarative qt6-multimedia qt6-multimedia-ffmpeg plocate polkit util-linux coreutils libarchive glib2)
makedepends=(cmake)
optdepends=('cifs-utils: network locations (SMB shares)'
            'avahi: finding servers on the network'
            'udisks2: mounting drives'
            'libnotify: a notice when a copy finishes with the window closed'
            'git: git status badges'
            'unzip: zip and epub previews'
            'zip: compressing to .zip'
            '7zip: opening .7z archives'
            'poppler: PDF previews'
            'ffmpeg: video details'
            'ffmpegthumbnailer: video thumbnails'
            'libraw: RAW photo previews'
            'exiv2: photo details'
            'source-highlight: coloured code previews'
            'f3d: 3D model previews')

build() {
    cmake -B build -S "$startdir/.." -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr
    cmake --build build --target kaze
}

package() {
    DESTDIR="$pkgdir" cmake --install build
}
